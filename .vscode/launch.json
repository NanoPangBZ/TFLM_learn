{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug demo (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/demo/${input:demoTarget}/build/${input:demoTarget}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "demoTarget",
            "type": "pickString",
            "description": "选择 demo 目标",
            "options": ["0_sdl_setup"]
        }
    ]
}
