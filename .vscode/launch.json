{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/${input:tflmTarget}/debug/${input:tflmTarget}.exe",
            "args": [],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb",
            "miDebuggerPath": "C:/mingw64/bin/gdb.exe",
            "preLaunchTask": "build ${input:tflmTarget} (debug)",
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ],
    "inputs": [
        {
            "id": "tflmTarget",
            "type": "pickString",
            "description": "选择编译目标 (src/target)",
            "options": [
                "TFLM_LEARN",
                "platform_develop"
            ],
            "default": "TFLM_LEARN"
        }
    ]
}
